{
  pkgs,
  inputs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/virtualisation/lxc-container.nix")
    # Generated by OrbStack, copied from /etc/nixos inside the machine.
    ./incus.nix
    ./orbstack.nix
    inputs.home-manager.nixosModules.default
    ./home-manager.nix
  ];

  networking.hostName = "vm-dev";
  nixpkgs.hostPlatform = "aarch64-linux";

  # Copy this from OrbStack's generated configuration.nix; never change it afterwards.
  system.stateVersion = "26.11";

  # Container: no bootloader, GNOME, audio etc.
  desktop-base.enable = false;

  # Copy uid/groups from OrbStack's generated configuration.nix.
  users.users.boyd = {
    uid = 501;
    isSystemUser = true;
    group = "users";
    createHome = true;
    home = "/home/boyd";
    homeMode = "700";
    useDefaultShell = true;
    extraGroups = [
      "wheel"
      "orbstack"
      "docker"
    ];
  };
  security.sudo.wheelNeedsPassword = false;

  time.timeZone = "Europe/Amsterdam";

  nix.settings = {
    experimental-features = [
      "nix-command"
      "flakes"
    ];
    extra-substituters = [ "https://cache.numtide.com" ];
    extra-trusted-public-keys = [
      "niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g="
    ];
  };
  nixpkgs.config.allowUnfree = true;

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 15d";
  };

  environment.systemPackages = [
    pkgs.git
    pkgs.ghostty.terminfo
  ];

  programs.nix-ld.enable = true;

  # 1Password CLI only; the Mac's SSH agent is forwarded by OrbStack.
  programs._1password.enable = true;

  lazy.enable = true;
  virtualisation.docker.enable = true;
  ai.enable = true;
}
